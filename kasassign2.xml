    <rule>
        <description>If the person commits a tortious act against another person, and the 
        tortious act can be attributed to them, the person must repair the damage that the 
        other person suffered as a result of the tortious act.</description>
        <if>
            <and>
                <fact name="tortious-act-against-person">yes</fact>
                <fact name="tortious-act-attributed">yes</fact>
            </and>
        </if>
        <then>
            <fact name="must-repair-damages">yes</fact>
        </then>
    </rule>

    <rule>
        <description>If an act or omission is in violation of another's right, in violation 
        of the law or of proper social conduct, and there is no justification, this act or 
        omission is a tortious act against the other person.</description>
        <if>
            <and>
                <fact name="violation-others-right">yes</fact>
                <or>
                    <fact name="violation-law">yes</fact>
                    <fact name="violation-socialconduct">yes</fact>
                </or>
                <fact name="justification">no</fact>
            </and>
        </if>
        <then>
            <fact name="tortious-act-against-person">yes</fact>
        </then>
    </rule>

    <rule>
        <description>If the tortious act is a result of the tortfeasors fault or of a cause 
        for which they are accountable by law or by generally accepted principles, the 
        tortious act is attributed to the tortfeasor. </description>
        <if>
            <or>
                <fact name ="cause-fault">yes</fact>
                <fact name ="cause-accountable-by-law">yes</fact>
                <fact name ="cause-accountable-by-principles">yes</fact>
            </or>
        </if>
        <then>
            <fact name ="tortious-act-attributed">yes</fact>
        </then>
    </rule>



    
    
    <rule>
        <description>If the person commits a tortious act against another person, is 
        older than 13, and has a mental or physical disability, the tortious act is still
        attributed to them. </description>
        <if>
            <and>
                <fact name="tortious-act-against-person">yes</fact>
                <fact name="older-than-13">yes</fact>
                <or>
                    <fact name="mental-disability">yes</fact>
                    <fact name="physical-disability">yes</fact>
                </or>
            </and>
        </if>
        <then>
            <fact name="tortious-act-attributed">yes</fact>
        </then>
    </rule>
    
    
